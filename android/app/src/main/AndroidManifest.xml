<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CTR Mobile"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- The launcher is what the app opens on: it picks the disc image and
             the settings, then starts the game. It has to be the entry point
             rather than the game, because without a disc image the game has
             nothing to validate and exits, which reads as a crash. -->
        <activity
            android:name=".CTRNativeLauncherActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:label="CTR Mobile"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- resizeableActivity="false" matters as much as the orientation
             request: without it newer Android and some OEM shells force the
             activity resizable and hand it a portrait drawable anyway. -->
        <activity
            android:name=".CTRNativeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:label="CTR Mobile"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:exported="false" />

        <activity
            android:name=".CTRControlsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:label="Controles da tela"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:exported="false" />
        <activity
            android:name=".CTRGamepadActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:label="Configurar gamepad"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:exported="false" />
    </application>

</manifest>
